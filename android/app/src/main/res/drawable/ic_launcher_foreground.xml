<?xml version="1.0" encoding="utf-8"?>
<!-- Vinyl record with a play button, pink -> magenta -> violet across the disc. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Disc body. -->
    <path android:pathData="M54,24a30,30 0 1,0 0,60a30,30 0 1,0 0,-60z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="22"
                android:startY="20"
                android:endX="88"
                android:endY="88"
                android:startColor="#FFFB7299"
                android:centerColor="#FFD45FE2"
                android:endColor="#FF7E6BFF" />
        </aapt:attr>
    </path>
    <!-- Upper-left sheen for a glossy vinyl surface. -->
    <path android:pathData="M54,24a30,30 0 1,0 0,60a30,30 0 1,0 0,-60z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="38"
                android:centerY="30"
                android:gradientRadius="42"
                android:startColor="#33FFFFFF"
                android:centerColor="#14FFFFFF"
                android:endColor="#00FFFFFF" />
        </aapt:attr>
    </path>
    <!-- Rim and grooves. -->
    <path
        android:fillColor="#00000000"
        android:pathData="M54,24.7a29.3,29.3 0 1,0 0,58.6a29.3,29.3 0 1,0 0,-58.6z"
        android:strokeColor="#73FFFFFF"
        android:strokeWidth="1.2" />
    <path
        android:fillColor="#00000000"
        android:pathData="M54,28.8a25.2,25.2 0 1,0 0,50.4a25.2,25.2 0 1,0 0,-50.4z"
        android:strokeColor="#47FFFFFF"
        android:strokeWidth="1.3" />
    <path
        android:fillColor="#00000000"
        android:pathData="M54,32.2a21.8,21.8 0 1,0 0,43.6a21.8,21.8 0 1,0 0,-43.6z"
        android:strokeColor="#29FFFFFF"
        android:strokeWidth="1.1" />
    <!-- Dark label: keeps the white play glyph readable at 48dp. -->
    <path
        android:pathData="M54,39.4a14.6,14.6 0 1,0 0,29.2a14.6,14.6 0 1,0 0,-29.2z"
        android:strokeColor="#33FFFFFF"
        android:strokeWidth="1">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="50"
                android:gradientRadius="19"
                android:startColor="#FF181A2C"
                android:centerColor="#FF11121E"
                android:endColor="#FF0A0B12" />
        </aapt:attr>
    </path>
    <!-- Play glyph; the round stroke join supplies the rounded corners. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M49.8,47L62.2,54L49.8,61Z"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="4.2" />
</vector>
